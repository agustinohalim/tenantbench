```sql
SELECT 
    c.segment,
    SUM(o.amount) AS total_order_amount
FROM 
    customers c
JOIN 
    orders o ON c.customer_id = o.customer_id
WHERE 
    c.tenant_id = 3 AND o.order_date >= '2024-01-01' AND o.order_date < '2025-01-01'
GROUP BY 
    c.segment;
```
